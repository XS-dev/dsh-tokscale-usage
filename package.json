{
  "name": "dsh-tokscale-usage",
  "version": "0.9.0",
  "description": "Local multi-agent token usage and telemetry dashboard for DeepSeek Harness powered by tokscale and dsh-context.",
  "author": "XS-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XS-dev/dsh-tokscale-usage.git"
  },
  "homepage": "https://github.com/XS-dev/dsh-tokscale-usage",
  "bugs": {
    "url": "https://github.com/XS-dev/dsh-tokscale-usage/issues"
  },
  "type": "module",
  "main": "index.mjs",
  "icon": "icon.svg",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "tokscale",
    "usage",
    "token",
    "telemetry"
  ],
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README*.md",
    "LICENSE"
  ],
  "dependencies": {
    "@tokscale/cli": "^4.19.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.1 || >=0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.1 <0.2.2 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test"
  }
}
